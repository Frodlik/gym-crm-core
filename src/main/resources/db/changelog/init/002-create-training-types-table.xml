<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-training-types-table" author="Vadym Zakletskyi">
        <createTable tableName="training_types">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_training_types"/>
            </column>
            <column name="training_type_name" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_training_types_name"/>
            </column>
        </createTable>

        <insert tableName="training_types">
            <column name="training_type_name" value="Cardio"/>
        </insert>
        <insert tableName="training_types">
            <column name="training_type_name" value="Strength"/>
        </insert>
        <insert tableName="training_types">
            <column name="training_type_name" value="Flexibility"/>
        </insert>
        <insert tableName="training_types">
            <column name="training_type_name" value="HIIT"/>
        </insert>
        <insert tableName="training_types">
            <column name="training_type_name" value="Yoga"/>
        </insert>
        <insert tableName="training_types">
            <column name="training_type_name" value="Pilates"/>
        </insert>
    </changeSet>

</databaseChangeLog>